{
  "name": "migrateiq-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MigrateIQ - Intelligent Database Migration Planner Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run shared:build",
    "web:dev": "npm run dev --workspace=@migrateiq/web",
    "web:build": "npm run build --workspace=@migrateiq/web",
    "desktop:dev": "npm run shared:build && npm run dev --workspace=@migrateiq/desktop",
    "desktop:build": "npm run shared:build && npm run build --workspace=@migrateiq/desktop",
    "shared:build": "npm run build --workspace=@migrateiq/shared",
    "seed:sample": "node scripts/seed-sample-dbs.js",
    "seed:phase7": "node scripts/seed-phase7-testbed.js",
    "seed:phase8": "node scripts/seed-phase8-testbed.js",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.4.5"
  }
}
