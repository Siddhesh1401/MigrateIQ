## 2. Real-Time Event Payload Lifecycle

```
[MIGRATION STARTED]
        │
        ├── event: "phase_change"  --> { phase: "CREATING_TABLES", progress: 10% }
        │
        ├── event: "table_start"   --> { table: "users", totalDocs: 1240 }
        │
        ├── event: "table_progress"--> { table: "users", migrated: 600, total: 1240, percent: 48.4% }
        │
        ├── event: "row_warning"   --> { table: "users", docId: "64a...", error: "Invalid email syntax" }
        │
        ├── event: "table_complete"--> { table: "users", inserted: 1239, skipped: 1 }
        │
        └── event: "complete"      --> { summary: { totalTables: 3, totalRows: 14233, durationMs: 3840 } }
```

### Backend SSE Endpoint Pattern (Express / Next.js API):
```javascript
export async function handleMigrationStream(req, res) {
  res.writeHead(200, {
    'Content-Type': 'text/event-stream',
    'Cache-Control': 'no-cache',
    'Connection': 'keep-alive',
  });

  const sendEvent = (eventType, data) => {
    res.write(`event: ${eventType}\ndata: ${JSON.stringify(data)}\n\n`);
  };

  // Run migration and broadcast updates
  await executeMigration(plan, {
    onProgress: (table, migrated, total) => {
      sendEvent('table_progress', { table, migrated, total, percent: Math.round((migrated / total) * 100) });
    },
    onError: (table, docId, error) => {
      sendEvent('row_error', { table, docId, error });
    }
  });

  sendEvent('complete', { success: true, timestamp: new Date().toISOString() });
  res.end();
}
```

